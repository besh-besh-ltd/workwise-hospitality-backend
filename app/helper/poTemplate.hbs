<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Purchase Order</title>

  <style>
    @page { size: A4; margin: 10mm; }
    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11px;
      color: #000;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    td, th {
      padding: 6px 8px;
      vertical-align: top;
    }
    .border {
      border: 1px solid #000;
    }
    .center {
      text-align: center;
    }
    .right {
      text-align: right;
    }
    .left {
      text-align: left;
    }
    .bold {
      font-weight: bold;
    }
    .small {
      font-size: 10px;
    }
    .section-title {
      border-bottom: 1px solid #000;
      font-weight: bold;
      padding-top: 6px;
      padding-bottom: 4px;
    }
    .checkbox {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 1px solid #000;
      text-align: center;
      line-height: 10px;
      font-size: 10px;
      margin-right: 4px;
      vertical-align: middle;
    }
    .checkbox.checked {
      background-color: #4CAF50;
      color: white;
    }
    .approval-box {
      border: 2px solid #000;
      margin-top: 20px;
    }
    .approval-box td {
      border: 1px solid #000;
      padding: 8px;
    }
    .approval-header {
      background: #f5f5f5;
      font-weight: bold;
      text-align: center;
    }
    .approval-detail-table td,
    .approval-detail-table th {
      border: none !important;
      padding: 3px 4px !important;
      text-align: left;
      vertical-align: top;
    }
    .approval-detail-table th {
      font-weight: bold;
    }
    .tax-amount-line {
      display: block;
      margin-top: 2px;
      font-size: 10px;
      line-height: 1.3;
    }
    .term-number {
      width: 22px;
      vertical-align: top;
      font-weight: bold;
      white-space: nowrap;
      text-align: right;
      padding-right: 6px;
    }
    .term-content {
      font-size: 10px;
      line-height: 1.4;
      word-wrap: break-word;
    }
    .term-content p {
      margin: 0 0 4px 0;
    }
    .term-content p:last-child {
      margin-bottom: 0;
    }
    .term-content ul,
    .term-content ol {
      margin: 4px 0;
      padding-left: 18px;
    }
    .term-content li {
      margin-bottom: 2px;
    }
    .term-content strong,
    .term-content b {
      font-weight: bold;
    }
    .term-content em,
    .term-content i {
      font-style: italic;
    }
    .term-content u {
      text-decoration: underline;
    }
    .term-content h1,
    .term-content h2,
    .term-content h3,
    .term-content h4,
    .term-content h5,
    .term-content h6 {
      margin: 6px 0 4px 0;
      font-weight: bold;
    }
    .term-content h1 { font-size: 13px; }
    .term-content h2 { font-size: 12px; }
    .term-content h3,
    .term-content h4,
    .term-content h5,
    .term-content h6 { font-size: 11px; }
    .term-content a {
      color: #1a73e8;
      text-decoration: underline;
      word-break: break-all;
    }
    .term-content table {
      width: auto;
      border-collapse: collapse;
      margin: 4px 0;
    }
    .term-content table td,
    .term-content table th {
      border: 1px solid #ccc;
      padding: 3px 6px;
    }
    .term-content img {
      max-width: 100%;
      height: auto;
    }
  </style>
</head>

<body>

  <!-- HEADER - Middle Top: PO Title, Project Name, RFQ Title -->
  <table>
    <tr>
      <td class="center bold" colspan="3" style="font-size: 22px; font-weight: 800; padding-bottom: 10px;">
        PURCHASE ORDER
        {{#if buyer.name}}
          <br/><span style="font-size: 12px; font-weight: normal;">
            Company Name: {{buyer.name}}{{#if buyer.business_unit_name}}, Business Unit: {{buyer.business_unit_name}}{{/if}}
          </span>
        {{/if}}
        {{#if project_name}}
          <br/><span style="font-size: 13px;">{{project_name}}</span>
        {{/if}}
      </td>
    </tr>
  </table>

  <br/>

  <!-- VENDOR (Left) + PO META (Right) -->
  <table>
    <tr>
      <!-- Vendor Details - Top Left, Stacked Vertically -->
      <td style="width: 50%;">
        <div class="bold" style="margin-bottom: 4px;">Vendor Details</div>
        <strong>{{supplier.name}}</strong><br/>
        {{supplier.address}}
        {{#if supplier.state_name}}
          <br/>State: {{supplier.state_name}}
        {{/if}}
        {{#if supplier.gstin}}
          <br/>GSTIN: {{supplier.gstin}}
        {{/if}}
        {{#if supplier.cin}}
          <br/>CIN: {{supplier.cin}}
        {{/if}}
        {{#if supplier.phone}}
          <br/>Phone: {{supplier.phone}}
        {{/if}}
        {{#if supplier.email}}
          <br/>Email: {{supplier.email}}
        {{/if}}
      </td>
      <!-- Right Column: RFQ No, PO Number, PO Date -->
      <td style="width: 50%;">
        <table>
          {{#if rfq_no}}
          <tr>
            <td class="bold" style="width: 40%;">RFQ No</td>
            <td>{{rfq_no}}</td>
          </tr>
          {{/if}}
          {{#if rfq_title}}
          <tr>
            <td class="bold" style="width: 40%;">RFQ Title</td>
            <td>{{rfq_title}}</td>
          </tr>
          {{/if}}
          <tr>
            <td class="bold">PO Number</td>
            <td>{{po_number}}</td>
          </tr>
          <tr>
            <td class="bold">PO Date</td>
            <td>{{created_at}}</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <br/>

  <div class="section-title">
    Please arrange to supply the following material/s as per the schedule given under:
    <span style="float:right;">All Rates & Amount are in INR</span>
  </div>

  <!-- ITEMS TABLE -->
  <table class="border">
    <thead>
      <tr class="border bold">
        <th class="center" style="width: 4%;">Sl</th>
        <th class="left" style="width: 30%;">Item Name &amp; Charges</th>
        <th class="center" style="width: 7%;">UOM</th>
        <th class="right" style="width: 9%;">Quantity</th>
        <th class="right" style="width: 10%;">Rate</th>
        <th class="center" style="width: 12%;">GST (%)</th>
        <th class="right" style="width: 12%;">Basic</th>
        <th class="right" style="width: 16%;">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr class="border">
        <td class="center">{{inc @index}}</td>
        <td>
          {{product_name}}
          {{#if size}}
            <br/><span class="small">Size: {{size}}</span>
          {{/if}}
          {{#if specification}}
            <br/><span class="small">Spec: {{specification}}</span>
          {{/if}}
          {{#if item_code}}
            <br/><span class="small">[{{item_code}}]</span>
          {{/if}}
          {{#if hsn_code}}
            <br/><span class="small">[HSN/SAC: {{hsn_code}}]</span>
          {{/if}}
          {{#if delivery_period_display}}
            <br/><span class="small">Delivery Period: {{delivery_period_display}}</span>
          {{/if}}
          {{#if comment}}
            <br/><span class="small">Comment: {{{nl2br comment}}}</span>
          {{/if}}
          {{#if charge_details}}
            {{#each charge_details}}
              <br/><span class="small">{{name}}{{#if rate_display}} ({{rate_display}}){{/if}}: ₹{{amount}}</span>
              {{#if has_tax}}
                <br/><span class="small" style="color:#888;">incl. ₹{{tax}} tax{{#if has_comment}} - {{comment}}{{/if}}</span>
              {{else}}
                {{#if has_comment}}<br/><span class="small" style="color:#888; font-style:italic;">- {{comment}}</span>{{/if}}
              {{/if}}
            {{/each}}
          {{/if}}
        </td>
        <td class="center">{{unit}}</td>
        <td class="right">{{quantity}}</td>
        <td class="right">{{unit_price_display}}</td>
        <td class="center">
          {{tax_rate_display}}%
          {{#if cgst_amount}}
            <span class="tax-amount-line">CGST ₹{{formatCurrency cgst_amount}}</span>
            <span class="tax-amount-line">SGST ₹{{formatCurrency sgst_amount}}</span>
          {{else}}
            {{#if igst_amount}}
              <span class="tax-amount-line">IGST ₹{{formatCurrency igst_amount}}</span>
            {{else}}
              {{#if gst_amount}}
                <span class="tax-amount-line">₹{{formatCurrency gst_amount}}</span>
              {{/if}}
            {{/if}}
          {{/if}}
        </td>
        <td class="right">{{basic_amount}}</td>
        <td class="right bold">{{subtotal}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <br/>

  <!-- COST BREAKUP — only aggregated totals + PO-level global charges. The
       per-line freight / packaging / insurance breakdown is shown inline
       in each row's Subtotal column above, so it's not repeated here. -->
  <table>
    <tr>
      <td style="width: 60%;"></td>
      <td style="width: 40%;">
        <table>
          <tr>
            <td class="bold">Total Basic</td>
            <td class="right">{{basicAmount}}</td>
          </tr>
          {{#if totalCharges}}
          <tr>
            <td>Total Charges <span style="font-weight: 400; color: #666;">(incl. of tax)</span></td>
            <td class="right">{{totalCharges}}</td>
          </tr>
          {{/if}}
          {{#each summaryTaxRows}}
          <tr>
            <td>{{label}}</td>
            <td class="right">{{amount}}</td>
          </tr>
          {{/each}}
          <tr class="bold">
            <td>Subtotal</td>
            <td class="right">{{totalSubtotal}}</td>
          </tr>
          {{#if globalCharges}}
            {{#each globalCharges}}
            <tr>
              <td>
                {{name}}{{#if rate_display}} <small style="color:#888; font-weight:normal;">({{rate_display}})</small>{{/if}}
                <small style="color:#888; font-weight:normal;">(PO-level)</small>
                {{#if additional_tax}}<br/><small style="color:#888; font-weight:normal;">incl. ₹{{additional_tax}} tax{{#if additional_tax_display}} ({{additional_tax_display}}){{/if}}</small>{{/if}}
                {{#if has_comment}}<br/><small style="color:#888; font-style:italic; font-weight:normal;">- {{comment}}</small>{{/if}}
              </td>
              <td class="right">{{amount}}</td>
            </tr>
            {{/each}}
          {{/if}}
          <tr class="bold">
            <td>Total PO Value :</td>
            <td class="right">{{totalPrice}}</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <br/>

  <!-- DELIVERY & BUYER DETAILS -->
  <div class="section-title">DELIVERY & BUYER DETAILS</div>

  <table>
    <tr>
      <td style="width: 50%; vertical-align: top; padding-right: 20px;">
        <strong>Delivery Address:</strong><br/>
        {{#if delivery_location}}
          {{delivery_location}}
        {{else}}
          {{location}}
        {{/if}}
        {{#if buyer.contact_person}}
          <div style="border-top: 1px solid #ccc; margin-top: 6px; padding-top: 6px;">
            <strong>Contact Information:</strong><br/>
            {{buyer.contact_person}}{{#if buyer.phone}} &nbsp;|&nbsp; {{buyer.phone}}{{/if}}{{#if buyer.email}} &nbsp;|&nbsp; {{buyer.email}}{{/if}}
          </div>
        {{/if}}
      </td>
      <td style="width: 50%; vertical-align: top; padding-left: 20px;">
        <strong>Buyer Details:</strong><br/>
        {{buyer.name}}<br/>
        {{#if buyer.business_unit_name}}
          <span class="small">Business Unit: {{buyer.business_unit_name}}</span><br/>
        {{/if}}
        {{#if buyer.address}}
          {{buyer.address}}
        {{else}}
          {{company.address}}
        {{/if}}
        {{#if buyer.state_name}}
          <br/>State: {{buyer.state_name}}
        {{/if}}
        {{#if buyer.gstin}}
          <br/>GSTIN: {{buyer.gstin}}
        {{/if}}
      </td>
    </tr>
  </table>

  <br/>

  <!-- PAYMENT TERMS - Dedicated Section Before Terms & Conditions -->
  {{#if paymentTermsList.length}}
  <div class="section-title">PAYMENT TERMS</div>
  <table class="small" style="margin-top: 8px;">
    <tr>
      <td>
        <ul style="margin: 4px 0; padding-left: 16px;">
          {{#each paymentTermsList}}
            <li>{{capitalize type}}: {{value}}%{{#if days}} ({{days}} days){{/if}}{{#if comment}} - {{comment}}{{/if}}</li>
          {{/each}}
        </ul>
      </td>
    </tr>
  </table>
  <br/>
  {{/if}}

  <!-- TERMS AND CONDITIONS - Numbered List -->
  <div class="section-title">TERMS AND CONDITIONS</div>

  <table class="small" style="margin-top: 8px;">
    {{#if deliveryterms}}
    <tr>
      <td class="term-number">1.</td>
      <td><strong>Delivery Terms:</strong> {{deliveryterms}} days</td>
    </tr>
    {{/if}}
    {{#each rfqTerms}}
    <tr>
      <td class="term-number">{{#if ../deliveryterms}}{{add @index 2}}{{else}}{{add @index 1}}{{/if}}.</td>
      <td><div class="term-content">{{{term_content}}}</div></td>
    </tr>
    {{/each}}
  </table>

  {{#if global_comment}}
  <br/>
  <div class="section-title">QUOTE COMMENTS</div>
  <table class="small" style="margin-top: 8px;">
    <tr>
      <td>{{{nl2br global_comment}}}</td>
    </tr>
  </table>
  {{/if}}

  <br/>

  <!-- APPROVAL BOX -->
  <table class="approval-box">
    <tr>
      <td class="approval-header" colspan="2">
        APPROVAL DETAILS
      </td>
    </tr>
    <tr>
      <td style="width: 28%; vertical-align: top;"><strong>Created By</strong></td>
      <td style="width: 72%; vertical-align: top;">
        {{#unless isAutoPublished}}
          <table class="approval-detail-table" style="width: 100%;">
            <tr>
              <th style="width: 18%;">Role</th>
              <th>Name</th>
            </tr>
            <tr>
              <td class="small">Creator</td>
              <td>{{#if rfqCreatorName}}{{rfqCreatorName}}{{else}}-{{/if}}</td>
            </tr>
            <tr>
              <td class="small">Approver</td>
              <td>{{#if rfqApproverName}}{{rfqApproverName}}{{else}}-{{/if}}</td>
            </tr>
          </table>
        {{else}}
          -
        {{/unless}}
      </td>
    </tr>
    <tr>
      <td style="vertical-align: top;"><strong>Technical Evaluation</strong></td>
      <td style="vertical-align: top;">
        {{#if techEvaluations.evaluators.length}}
          <table class="approval-detail-table" style="width: 100%;">
            <tr>
              <th style="width: 18%;">Role</th>
              <th>Name</th>
            </tr>
            <tr>
              <td class="small">Evaluator</td>
              <td>
                {{#each techEvaluations.evaluators}}
                  {{this}}{{#unless @last}}, {{/unless}}
                {{/each}}
              </td>
            </tr>
            <tr>
              <td class="small">Approvers</td>
              <td>
                {{#if techEvaluations.approvers.length}}
                  {{#each techEvaluations.approvers}}
                    {{this}}{{#unless @last}}, {{/unless}}
                  {{/each}}
                {{else}}
                  -
                {{/if}}
              </td>
            </tr>
          </table>
        {{else}}
          -
        {{/if}}
      </td>
    </tr>
    <tr>
      <td style="vertical-align: top;"><strong>Commercial Evaluation</strong></td>
      <td style="vertical-align: top;">
        {{#if commercialEvaluations.evaluators.length}}
          <table class="approval-detail-table" style="width: 100%;">
            <tr>
              <th style="width: 18%;">Role</th>
              <th>Name</th>
            </tr>
            <tr>
              <td class="small">Evaluator</td>
              <td>
                {{#each commercialEvaluations.evaluators}}
                  {{this}}{{#unless @last}}, {{/unless}}
                {{/each}}
              </td>
            </tr>
            <tr>
              <td class="small">Approvers</td>
              <td>
                {{#if commercialEvaluations.approvers.length}}
                  {{#each commercialEvaluations.approvers}}
                    {{this}}{{#unless @last}}, {{/unless}}
                  {{/each}}
                {{else}}
                  -
                {{/if}}
              </td>
            </tr>
          </table>
        {{else}}
          -
        {{/if}}
      </td>
    </tr>
    <tr>
      <td style="vertical-align: top;"><strong>PO Approvers</strong></td>
      <td style="vertical-align: top;">
        {{#if poApprovers}}
          <table class="approval-detail-table" style="width: 100%;">
            <tr>
              <th style="width: 38%;">Name</th>
              <th style="width: 18%;">Status</th>
              <th>Actioned On</th>
            </tr>
            {{#each poApprovers}}
            <tr>
              <td>{{name}}</td>
              <td style="{{#eq status 'Approved'}}color: #22c55e;{{/eq}}{{#eq status 'Rejected'}}color: #ef4444;{{/eq}}{{#eq status 'Skipped'}}color: #f59e0b;{{/eq}}{{#eq status 'Invited'}}color: #6b7280;{{/eq}}">{{status}}</td>
              <td>{{#if timestamp}}{{timestamp}}{{else}}-{{/if}}</td>
            </tr>
            {{/each}}
          </table>
        {{else}}
          -
        {{/if}}
      </td>
    </tr>
  </table>

</body>
</html>
