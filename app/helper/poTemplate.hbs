<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Purchase Order - {{poNumber}}</title>
  <style>
    @page { size: A4; margin: 8mm; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; font-size: 11px; color: #000; background: #f5f5f5; }

    .document { 
      background: white; 
      width: 100%; 
      max-width: 210mm; 
      margin: 0 auto; 
      padding: 4px;
      border: 1px solid #000; 
      overflow: hidden;
    }
    
    /* HEADER */
    .header { 
      display: flex; 
      align-items: flex-start; 
      padding: 20px 16px 8px 16px; 
      border-bottom: 1px solid #000; 
    }
    
    .logo { width: 68px; height: auto; margin-right: 12px; }
    
    .company-info { flex: 1; }
    .company-name { 
      color: #2196F3; 
      font-size: 20px; 
      font-weight: bold;
      font-style: italic; 
      letter-spacing: 0.5px; 
    }
    .company-cin { 
      font-size: 9px; 
      color: #444; 
      margin: 2px 0; 
    }
    .company-subtitle { 
      font-size: 8px; 
      color: #666; 
      font-style: italic; 
    }
    
    .contact-info { 
      max-width: 250px;
      text-align: right; 
      font-size: 10px; 
      line-height: 1.3; 
      border-left: 2px solid #d32f2f;
      padding-left: 12px;
      margin-left: 12px;
    }
    .contact-info .address { font-weight: bold; }
    .contact-info .phone { color: #000; }
    .contact-info .website { color: #2196F3; }
    
    /* PURCHASE ORDER TITLE */
    .po-title { 
      background: #e0e0e0; 
      text-align: center; 
      font-size: 16px; 
      font-weight: bold; 
      padding: 6px 0; 
      border-bottom: 1px solid #000; 
    }
    
    /* MAIN CONTENT TABLE */
    .main-table { 
      width: 100%; 
      border-collapse: collapse; 
      font-size: 10px; 
    }
    .main-table td { 
      border: 1px solid #000; 
      border-top: 0px;
      padding: 8px; 
      vertical-align: top; 
    }

    .dual-section {
      display: flex;
      flex-direction: column;
      gap: 1rem
    }

    .flex-section {
      display: flex;
      gap: 1rem
    }

    .flex-section div {
      width: 100%;
    }
    
    /* SECTION HEADERS */
    .section-header { 
      background: #f5f5f5; 
      font-weight: bold; 
      font-size: 11px; 
      padding: 4px 8px; 
      border-bottom: 1px solid #ccc; 
    }
    
    /* PO META INFO */
    .po-meta-table { 
      width: 100%; 
      font-size: 10px; 
    }
    .po-meta-table td { 
      border: none; 
      padding: 2px 4px; 
    }
    .po-meta-table .label { width: 60%; }
    .po-meta-table .value { 
      text-align: right; 
      font-weight: bold; 
    }
    .po-meta-table .colon { width: 10px; text-align: center; }
    
    /* KIND ATTENTION */
    .kind-attention { 
      background: #fff8e1; 
      border: 1px solid #000; 
      margin: 8px 0px; 
      padding: 8px; 
      border-radius: 4px; 
    }
    .attention-title { 
      font-weight: bold; 
      margin-bottom: 6px; 
    }
    
    /* ITEMS TABLE */
    .items-table { 
      width: 100%; 
      border-collapse: collapse; 
      font-size: 10px; 
    }
    .items-table th { 
      background: #f0f0f0; 
      border: 1px solid #000; 
      padding: 6px 4px; 
      text-align: center; 
      font-weight: bold; 
      font-size: 10px; 
    }
    .items-table td { 
      border: 1px solid #000; 
      padding: 6px 4px; 
      text-align: center; 
      font-size: 10px; 
    }
    .items-table .item-description { text-align: left; }
    .items-table .total-row { 
      background: #f5f5f5; 
      font-weight: bold; 
    }
    
    /* AMOUNT IN WORDS */
    .amount-words { 
      padding: 6px 0; 
      border-bottom: 1px solid #000; 
      font-style: italic; 
      display: flex; 
      justify-content: space-between; 
    }
    .amount-words .total { font-weight: bold; }
    
    /* BOTTOM SECTION */
    .bottom-table { 
      width: 100%; 
      border-collapse: collapse; 
      font-size: 10px; 
    }
    .bottom-table td { 
      border: 1px solid #000; 
      padding: 8px; 
      vertical-align: top; 
    }
    
    /* NOTES SECTION */
    .notes-section { 
      background: #e3f2fd; 
      border: 1px solid #000; 
      padding: 6px; 
      margin-bottom: 6px; 
      border-radius: 3px; 
      font-size: 9px; 
    }
    
    /* SIGNATURE */
    .signature-section { 
      text-align: right; 
      margin: 16px 8px 8px 8px; 
      font-weight: bold; 
    }
    .signature-line { 
      margin-top: 60px; 
      font-size: 11px; 
    }
    
    /* FOOTER */
    .footer { 
      text-align: center; 
      margin: 8px; 
      padding-top: 8px; 
      border-top: 2px solid #000; 
      font-size: 12px; 
    }
    .certifications { 
      display: flex; 
      justify-content: flex-end; 
      gap: 20px; 
      margin-top: 12px; 
    }
    .cert-badge { 
      display: flex; 
      align-items: center; 
      gap: 4px; 
      font-size: 8px; 
    }
    .cert-logo { width: 20px; height: 20px; }
  </style>
</head>
<body>
  <div class="document">
    <!-- HEADER -->
    <div class="header">
      {{#if company.logoUrl}}
        <img class="logo" src="{{company.logoUrl}}" alt="Company Logo" />
      {{/if}}
      
      <div class="company-info">
        <div class="company-name">{{company_name}}</div>
        {{#if cin}}
          <div class="company-cin">Corporate Identity Number: {{cin}}</div>
        {{/if}}
        {{!-- <div class="company-subtitle">(formerly known as Lakshya Powertech Private Limited)</div> --}}
      </div>
      
      <div class="contact-info">
        {{!-- <div class="address">A-620 & 621, SIDDHI VINAYAK<br>TOWERS, MAKARIA, S G<br>HIGHWAY, AHMEDABAD<br>GUJARAT- 380051</div> --}}
        <div class="address">{{location}}</div>
        <div class="phone">{{mobile}}</div>
        <div class="website">{{website}}</div>
      </div>
    </div>
    
    <!-- PURCHASE ORDER TITLE -->
    <div class="po-title">PURCHASE ORDER</div>
    
    <!-- MAIN CONTENT -->
    <table class="main-table">
      <tr>
        <!-- SUPPLIER INFO -->
        <td style="width: 40%;">
          <div class="dual-section">
            <div class="border-bottom">
              <div style="margin-bottom: 4px;"><strong>Supplier's Name & Address:</strong></div>
              <strong>{{supplier.name}}</strong><br>
              {{supplier.address}}<br>
              Phone No: {{supplier.phone}}<br>
              Email: {{supplier.email}}<br>
              {{#if supplier.gstin}}
                GSTIN: {{supplier.gstin}}<br>
              {{/if}}
              {{#if supplier.cin}}
                CIN: {{supplier.cin}}
              {{/if}}
            </div>
            <div class="flex-section">
              <div>
                <div style="margin-bottom: 4px;"><strong>Bill To:</strong></div>
                {{company_name}}
                {{location}}
                {{#if gstin}}
                  <br>
                  GSTIN: {{gstin}}
                {{/if}}
              </div>
              <div>
                <div style="margin-bottom: 4px;"><strong>Ship To:</strong></div>
                {{shipTo}}
              </div>
            </div>
          </div>
        </td>
        
        <!-- PO DETAILS -->
        <td style="width: 30%;">
          <table class="po-meta-table">
            <tr><td class="label">PO No</td><td class="colon">:</td><td class="value">{{po_number}}</td></tr>
            <tr><td class="label">PO Date</td><td class="colon">:</td><td class="value">{{created_at}}</td></tr>
            {{!-- <tr><td class="label">Quotation Ref.</td><td class="colon">:</td><td class="value">{{quotationRef}}</td></tr> --}}
            <tr><td class="label">Quotation Date</td><td class="colon">:</td><td class="value">{{quotationDate}}</td></tr>
            {{!-- <tr><td class="label">Other Ref.</td><td class="colon">:</td><td class="value">{{otherRef}}</td></tr> --}}
            <tr><td class="label">Buyer Name</td><td class="colon">:</td><td class="value">{{company_name}}</td></tr>
            <tr><td class="label">Buyer Contact No</td><td class="colon">:</td><td class="value">{{company.phone}}</td></tr>
            <tr><td class="label">Buyer's Email</td><td class="colon">:</td><td class="value">{{company.email}}</td></tr>
          </table>
        </td>
      </tr>
    </table>
    
    <!-- KIND ATTENTION -->
    <div style="margin: 10px 0px;">
      <div class="attention-title">Kind Attention :</div>
      Dear Sir,<br>
      We are pleased to place our order for the under mentioned Materials/Services in accordance with terms and conditions mentioned below. In all correspondence, Challans and Bills, Order Number as given above must be quoted in all documents. Kindly send two copies of all the invoices and dispatch documents. Please send order acceptance within two days from the date of this order.
    </div>
    
    <!-- ITEMS TABLE -->
    <table class="items-table">
      <thead>
        <tr>
          <th style="width: 5%;">Sr. No.</th>
          <th style="width: 35%;">Item / Product Details</th>
          <th style="width: 8%;">Quantity</th>
          <th style="width: 6%;">Unit</th>
          <th style="width: 12%;">Rate / Unit Rs.</th>
          <th style="width: 8%;">Disc. (%)</th>
          <th style="width: 8%;">GST (%)</th>
          <th style="width: 10%;">Tax Amount</th>
          <th style="width: 12%;">Total Amount Rs.</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td>{{inc @index}}</td>
          <td class="item-description">{{product_name}}</td>
          <td>{{quantity}}</td>
          <td>{{unit}}</td>
          <td>{{formatCurrency unit_price}}</td>
          <td>{{discountPercent}}</td>
          <td>{{tax}}</td>
          <td>{{formatCurrency taxAmount}}</td>
          <td>{{formatCurrency total_price}}</td>
        </tr>
        {{/each}}
        
        {{#each otherExpenses}}
        <tr>
          <td>{{inc @index}}</td>
          <td class="item-description">{{title}}</td>
          <td>{{quantity}}</td>
          <td>{{uom}}</td>
          <td>{{formatCurrency amount}}</td>
          <td></td>
          <td></td>
          <td></td>
          <td>{{formatCurrency amount}}</td>
        </tr>
        {{/each}}
        
        <tr class="total-row">
          <td colspan="7" style="text-align: right;"><strong>TOTAL :</strong></td>
          <td><strong>{{formatCurrency taxAmount}}</strong></td>
          <td><strong>{{formatCurrency totalPrice}}</strong></td>
        </tr>
      </tbody>
    </table>
    
    <!-- AMOUNT IN WORDS -->
    <div class="amount-words">
      <span>Amount in Words: <strong>{{amountInWords totalPrice}}</strong></span>
      <span class="total">Total: {{formatCurrency totalPrice}}</span>
    </div>
    
    <!-- BOTTOM SECTION -->
    <table class="bottom-table">
      <tr>
        <td style="width: 35%;">
          <div>Terms & Conditions</div>
          {{#if paymentTerms}}
            <strong>Payment :</strong> {{paymentTerms}}
          {{/if}}

          {{#if deliveryterms}}
            <strong>Delivery Terms :</strong> {{deliveryterms}}
          {{/if}}
        </td>
      </tr>
    </table>
    
    <!-- SIGNATURE -->
    <div class="signature-section">
      For, {{company_name}}<br>
      <div class="signature-line">Authorized Signatory</div>
    </div>

    <div class="bottom-table">
          {{!-- <div>Notes / Remarks :</div>
          <div style="margin-top: 4px;">{{notes}}</div> --}}
          <div style="font-size: 10px; margin-top: 6px;">{{terms}}</div>
        </div>
    
    <!-- FOOTER -->
    <div class="footer">
      Subject to <strong>JHARKHAND</strong> Jurisdiction
      <div class="certifications">
        <img style="max-height: 90px;" src="https://workwise-static-s3.s3.ap-south-1.amazonaws.com/iso-logo/ISO-logo.png" alt="ISO Logo">
      </div>
    </div>
  </div>
</body>
</html>