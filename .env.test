NODE_ENV=test
PORT=8002

# Local Postgres (brew install postgresql@17). Tests no longer hit staging RDS
# — that caused frequent ECONNRESET / dropped-connection flakes. The OS user
# is the brew default superuser; password is empty (peer auth on localhost).
# DATABASE_NAME is set dynamically by globalSetup based on runId (user/CI job).
HOST=localhost
DATABASE_USERNAME=apple
DATABASE_PASSWORD=
DATABASE_PORT=5432
DATABASE_DIALECT=postgres
TEST_DB_NO_SSL=1

# Maintenance DB used to issue CREATE/DROP DATABASE commands. On a brew
# install the maintenance DB defaults to the OS user's database.
TEST_MAINTENANCE_DB=postgres

# Test DB name prefix — runId is appended at runtime (e.g. hospitality_test_local).
# A safety guard refuses to touch any DB that does not match ^hospitality_test(_[a-zA-Z0-9_-]+)?$.
TEST_DB_PREFIX=hospitality_test

# Dummy secrets — enough to boot the app under test without leaking prod credentials.
JWT_SECRET=test_jwt_secret
CRYPT_SECRET=test_crypt_secret
REFRESH_TOKEN_SECRET=test_refresh_secret
JWT_EXPIRATION_IN_SECONDS=36000

# Mocks intercept these — values are placeholders.
SMTP_EMAIL=test@example.com
SMTP_USER_PASSWORD=test_smtp_pass
TEMPLATE_PATH=app/helper/email_template

AWS_ACCESS_KEY_ID=test_aws_key
AWS_SECRET_ACCESS_KEY=test_aws_secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=test-workwise-bucket

LAMBDA_ARN=arn:aws:lambda:ap-south-1:000000000000:function:Test
EVENTBRIDGE_ROLE_ARN=arn:aws:iam::000000000000:role/Test
GroupName=test
RFQ_PUBLISH_GROUP_NAME=testSchedulerGroup
SCHEDULER_SECRET=test_secret
WEBHOOK_SECRET=test_secret

PUBLIC_VAPID_KEY=BMlcHp3X2DtYmsKkev81HR4CJeOqxTyLEZC0JU3Fnxi7qaKqM7-qOWvgPCb4Q9FmFW6-hyc9AG4w4BtrHTkwO2c
PRIVATE_VAPID_KEY=U10j4lgXBPb5esS3hat9I1M92p59vXbMGBsOZLasjgE
WEB_PUSH_CONTACT="mailto:test@example.com"

RAZORPAY_KEY=test_razorpay_key
RAZORPAY_SECRET=test_razorpay_secret
RAZORPAY_SIGNATURE=test_razorpay_signature

FRONT_END_WEBSITE=http://localhost:3000
APP_BASE_PATH=http://localhost:8002
DOWNLOADD_URL=http://localhost:3000

AI_SERVER_URL=http://localhost:9999
AI_BASE_URL=http://localhost:9999
DEEPSEEK_API_KEY=test
GOOGLE_AI_API_KEY=test

AISENSY_API=http://localhost:9999
AISENSY_API_KEY=test
FLUX_CHAT_API=http://localhost:9999
FLUX_CHAT_KEY=test
