{
  "name": "DeshTechnicos",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "main": "server.js",
  "type": "module",
  "scripts": {
    "pretify": "prettier --config .prettierrc.json '**' --write",
    "lint": "eslint",
    "dev": "nodemon --experimental-json-modules --import ./otel-instrument.mjs server.js | pino-pretty --colorize --translateTime 'yyyy-mm-dd HH:MM:ss' --ignore 'pid,hostname,trace_id,span_id,trace_flags'",
    "start": "node --import ./otel-instrument.mjs server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --coverage",
    "test:setup": "NODE_ENV=test node tests/setup/prepareTestDb.js",
    "test:teardown": "NODE_ENV=test node tests/setup/dropTestDb.js",
    "test:cleanup": "NODE_ENV=test node tests/setup/dropTestDb.js --orphans",
    "test:shards": "node scripts/check-shard-coverage.mjs",
    "test:tooling": "node --test scripts/__tests__/*.test.mjs",
    "check:tx-response": "node scripts/check-response-in-tx.mjs",
    "test:snapshot-staging": "node tests/setup/snapshotStaging.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letsworkwise/workwise-backend.git"
  },
  "author": "workwise",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/letsworkwise/workwise-backend/issues"
  },
  "homepage": "https://github.com/letsworkwise/workwise-backend#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/client-scheduler": "^3.830.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.213.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "celebrate": "^15.0.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "cryptr": "^6.3.0",
    "dateformat": "^5.0.3",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase-admin": "^13.2.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "html-entities": "^2.5.3",
    "joi": "^17.13.3",
    "json2csv": "^6.0.0-alpha.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "multer": "^1.4.5-lts.2",
    "multer-s3": "^3.0.1",
    "node-cron": "^3.0.3",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^6.10.0",
    "number-to-words": "^1.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf2json": "^3.1.5",
    "pg": "^8.23.0",
    "pg-promise": "^11.13.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^24.4.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^30.2.0",
    "knip": "^6.9.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
